@{
    ViewData["Title"] = "Anonymous";
}

<div class="row">
    <div class="col-lg-8">
        <h1 class="display-6 mb-3">Public Page</h1>
        <p>
            This page does not require authentication.
            You can use the button below to sign in with Okta SSO.
        </p>

        <a asp-controller="Home" asp-action="OktaLogin" asp-route-returnUrl="/" class="btn btn-primary mb-4">
            Login with Okta
        </a>

        <h2 class="h5 mt-2">Auth Flow in this sample</h2>
        <ul>
            <li><strong>Local Login</strong>: hardcoded credentials for testing only.</li>
            <li><strong>Okta Login</strong>: redirects to Okta and returns via OIDC callback.</li>
            <li><strong>Cookie Sign-in</strong>: app stores authenticated session in cookie.</li>
            <li><strong>Protected pages</strong>: actions with <code>[Authorize]</code> need authentication.</li>
        </ul>
    </div>
</div>
